          </div>

          {/* Search Inputs Bar */}
          <div className="relative z-10 bg-slate-900/90 backdrop-blur-xl border border-slate-700 p-4 sm:p-6 rounded-2xl shadow-xl">
            {/* Mobile Category Tabs */}
