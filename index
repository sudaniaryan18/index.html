              <button 
                onClick={() => setActiveTab('flights')} 
                className={`flex items-center gap-1 text-xs font-semibold pb-1 ${activeTab === 'flights' ? 'text-indigo-400 border-b-2 border-indigo-500' : 'text-slate-400'}`}
              >
                <Plane className="w-3.5 h-3.5" /> Flights
              </button>
              <button 
                onClick={() => setActiveTab('trains')} 
                className={`flex items-center gap-1 text-xs font-semibold pb-1 ${activeTab === 'trains' ? 'text-indigo-400 border-b-2 border-indigo-500' : 'text-slate-400'}`}
              >
                <Train className="w-3.5 h-3.5" /> Trains
              </button>
              <button 
                onClick={() => setActiveTab('buses')} 
                className={`flex items-center gap-1 text-xs font-semibold pb-1 ${activeTab === 'buses' ? 'text-indigo-400 border-b-2 border-indigo-500' : 'text-slate-400'}`}
              >
                <Bus className="w-3.5 h-3.5" /> Buses
