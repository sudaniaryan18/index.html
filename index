                      <p className="font-bold text-slate-900">{item.type === 'package' ? item.title : `${item.from} → ${item.to}`}</p>
                      <p className="text-[10px] text-slate-500">{item.type === 'package' ? item.destination : item.code} • Seat(s): {item.selectedSeats.join(', ')}</p>
                    </div>
                    <span className="font-mono font-bold">${item.totalItemPrice.toFixed(2)}</span>
                  </div>
                ))}
              </div>

              <div className="mt-3 pt-2 border-t border-slate-200 flex justify-between items-center text-xs font-bold">
                <span>Total Paid:</span>
                <span className="text-emerald-600 text-sm font-mono">${confirmedBooking.totalAmount}</span>
              </div>
            </div>

            <button
              onClick={() => setConfirmedBooking(null)}
              className="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl transition"
            >
              Done & Save Ticket Pass
            </button>
          </div>
        </div>
      )}

      {}
      <div className="fixed bottom-6 right-6 z-40">
        {!isChatOpen ? (
          <button
            onClick={() => setIsChatOpen(true)}
            className="bg-indigo-600 hover:bg-indigo-500 text-white p-3.5 rounded-full shadow-2xl flex items-center gap-2 transition hover:scale-105"
          >
            <MessageSquare className="w-5 h-5" />
            <span className="text-xs font-bold hidden sm:inline">24/7 Fare Assistance</span>
          </button>
        ) : (
          <div className="bg-slate-900 border border-slate-700 w-80 sm:w-96 rounded-2xl shadow-2xl flex flex-col h-96 overflow-hidden animate-in slide-in-from-bottom-5 duration-200">
            {/* Chat Header */}
            <div className="bg-slate-800 p-3.5 border-b border-slate-700 flex items-center justify-between">
              <div className="flex items-center gap-2">
                <div className="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse" />
                <span className="text-xs font-bold text-white">OmniTravel Assistant</span>
              </div>
              <button onClick={() => setIsChatOpen(false)} className="text-slate-400 hover:text-white">
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Chat Messages */}
            <div className="flex-1 p-3 overflow-y-auto space-y-2.5 text-xs">
              {chatMessages.map((msg, i) => (
                <div key={i} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div className={`max-w-[80%] p-2.5 rounded-xl ${msg.sender === 'user' ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-200 border border-slate-700'}`}>
                    {msg.text}
                  </div>
                </div>
              ))}
            </div>

            {/* Chat Input */}
            <form onSubmit={handleSendMessage} className="p-2 border-t border-slate-800 flex gap-2 bg-slate-900">
              <input
                type="text"
                placeholder="Ask about cheap tickets..."
                value={chatInput}
                onChange={(e) => setChatInput(e.target.value)}
                className="flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none"
              />
              <button type="submit" className="bg-indigo-600 text-white p-2 rounded-xl hover:bg-indigo-500">
                <Send className="w-3.5 h-3.5" />
              </button>
            </form>
          </div>
        )}
      </div>

      {}
      <footer className="bg-slate-950 border-t border-slate-800 py-10 mt-16">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <div className="flex items-center gap-2 justify-center sm:justify-start mb-3">
              <Compass className="w-6 h-6 text-indigo-400" />
              <span className="text-lg font-black text-white">OmniTravel</span>
            </div>
            <p className="text-xs text-slate-400">
              Your premier ultra-budget travel partner offering negligible price tickets across Bus, Train, Flight, and Vacation Packages.
            </p>
          </div>

          <div>
            <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-3">Modes of Transit</h4>
            <ul className="space-y-2 text-xs text-slate-400">
              <li className="hover:text-indigo-400 cursor-pointer">Budget Flights</li>
              <li className="hover:text-indigo-400 cursor-pointer">High-Speed Trains</li>
              <li className="hover:text-indigo-400 cursor-pointer">Express AC Buses</li>
              <li className="hover:text-indigo-400 cursor-pointer">Island & Mountain Tours</li>
            </ul>
          </div>

          <div>
            <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-3">Customer Care</h4>
            <ul className="space-y-2 text-xs text-slate-400">
              <li className="hover:text-indigo-400 cursor-pointer">Instant Digital Refunds</li>
              <li className="hover:text-indigo-400 cursor-pointer">Baggage Guidelines</li>
              <li className="hover:text-indigo-400 cursor-pointer">Travel Insurance Claims</li>
              <li className="hover:text-indigo-400 cursor-pointer">24/7 Live Support</li>
            </ul>
          </div>

          <div>
            <h4 className="text-xs font-bold text-white uppercase tracking-wider mb-3">Guaranteed Safety</h4>
            <div className="flex items-center gap-2 text-xs text-emerald-400 bg-slate-900 border border-slate-800 p-3 rounded-xl">
              <Shield className="w-5 h-5 flex-shrink-0" />
              <span>100% Encrypted Payment & Guaranteed Low Fare Protection</span>
            </div>
          </div>
        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 mt-8 border-t border-slate-900 text-center text-xs text-slate-500">
          © {new Date().getFullYear()} OmniTravel Technologies Inc. All rights reserved.
        </div>
      </footer>

    </div>
  );
}