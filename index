            <button className="hidden sm:flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sm font-medium text-slate-200">
              <User className="w-4 h-4 text-indigo-400" /> Account
            </button>
