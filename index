export default function App() {
  // State management
  const [activeTab, setActiveTab] = useState('flights'); // flights, trains, buses, packages
  const [cart, setCart] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [selectedSeatItem, setSelectedSeatItem] = useState(null); // Item being configured in seat modal
