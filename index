  const [packageModalItem, setPackageModalItem] = useState(null);
  const [confirmedBooking, setConfirmedBooking] = useState(null);
  
  // Search parameters
  const [searchFrom, setSearchFrom] = useState('');
  const [searchTo, setSearchTo] = useState('');
  const [travelDate, setTravelDate] = useState('');
  
  // Coupon and insurance
  const [couponInput, setCouponInput] = useState('');
  const [appliedDiscount, setAppliedDiscount] = useState(0);
  const [includeInsurance, setIncludeInsurance] = useState(false);

  // Live Support Chat State
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [chatMessages, setChatMessages] = useState([
    { sender: 'bot', text: 'Hello! Welcome to OmniTravel. Looking for super cheap $0.99 tickets or vacation deals?' }
  ]);
  const [chatInput, setChatInput] = useState('');

  // Flash Sale Countdown State
  const [timeLeft, setTimeLeft] = useState({ hours: 4, minutes: 28, seconds: 45 });

  useEffect(() => {
    const timer = setInterval(() => {
      setTimeLeft(prev => {
        if (prev.seconds > 0) return { ...prev, seconds: prev.seconds - 1 };
        if (prev.minutes > 0) return { ...prev, minutes: 59, seconds: 59 };
        if (prev.hours > 0) return { hours: prev.hours - 1, minutes: 59, seconds: 59 };
        return { hours: 4, minutes: 0, seconds: 0 };
      });
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const filteredFlights = useMemo(() => {
    return MOCK_FLIGHTS.filter(item => 
      (!searchFrom || item.from.toLowerCase().includes(searchFrom.toLowerCase())) &&
      (!searchTo || item.to.toLowerCase().includes(searchTo.toLowerCase()))
    );
  }, [searchFrom, searchTo]);

  const filteredTrains = useMemo(() => {
    return MOCK_TRAINS.filter(item => 
      (!searchFrom || item.from.toLowerCase().includes(searchFrom.toLowerCase())) &&
      (!searchTo || item.to.toLowerCase().includes(searchTo.toLowerCase()))
    );
  }, [searchFrom, searchTo]);

  const filteredBuses = useMemo(() => {
    return MOCK_BUSES.filter(item => 
      (!searchFrom || item.from.toLowerCase().includes(searchFrom.toLowerCase())) &&
      (!searchTo || item.to.toLowerCase().includes(searchTo.toLowerCase()))
    );
  }, [searchFrom, searchTo]);

  const filteredPackages = useMemo(() => {
    return MOCK_PACKAGES.filter(item => 
      (!searchTo || item.destination.toLowerCase().includes(searchTo.toLowerCase()) || item.title.toLowerCase().includes(searchTo.toLowerCase()))
    );
  }, [searchTo]);

  const handleOpenSeatSelection = (item) => {
    setSelectedSeatItem(item);
    setSelectedSeats([]);
  };

  const toggleSeatSelection = (seatNo) => {
    if (selectedSeats.includes(seatNo)) {
      setSelectedSeats(selectedSeats.filter(s => s !== seatNo));
    } else {
      setSelectedSeats([...selectedSeats, seatNo]);
    }
  };

  const confirmSeatAndAddToCart = () => {
    if (selectedSeats.length === 0) return;
    const newItem = {
      ...selectedSeatItem,
      selectedSeats: [...selectedSeats],
      totalItemPrice: Number((selectedSeatItem.price * selectedSeats.length).toFixed(2)),
      cartId: `${selectedSeatItem.id}-${Date.now()}`
    };
    setCart(prev => [...prev, newItem]);
    setSelectedSeatItem(null);
    setSelectedSeats([]);
    setIsCartOpen(true);
  };

  const addPackageToCart = (pkg) => {
    const newItem = {
      ...pkg,
      selectedSeats: ['Package Booking (1 Pax)'],
      totalItemPrice: pkg.price,
      cartId: `${pkg.id}-${Date.now()}`
    };
    setCart(prev => [...prev, newItem]);
    setPackageModalItem(null);
    setIsCartOpen(true);
  };

  const removeFromCart = (cartId) => {
    setCart(cart.filter(item => item.cartId !== cartId));
  };

  const handleApplyCoupon = () => {
    if (couponInput.trim().toUpperCase() === 'SUPERDEAL') {
      setAppliedDiscount(0.5); // 50% discount off total
    } else {
      alert('Invalid Promo Code. Try "SUPERDEAL" for 50% off!');
    }
  };

  const calculateSubtotal = () => {
    return cart.reduce((acc, item) => acc + item.totalItemPrice, 0);
  };

  const calculateInsuranceCost = () => {
    return includeInsurance && cart.length > 0 ? 1.99 : 0;
  };

  const calculateFinalTotal = () => {
    const subtotal = calculateSubtotal();
    const discount = subtotal * appliedDiscount;
    const insurance = calculateInsuranceCost();
    const total = subtotal - discount + insurance;
    return Math.max(0, total).toFixed(2);
  };

  const handleCheckout = () => {
    if (cart.length === 0) return;
    const bookingRef = 'OMNI-' + Math.floor(100000 + Math.random() * 900000);
    const newBooking = {
      bookingRef,
      date: new Date().toLocaleDateString(),
      items: [...cart],
      totalAmount: calculateFinalTotal(),
      insuranceAdded: includeInsurance
    };
    setConfirmedBooking(newBooking);
    setCart([]);
    setIsCartOpen(false);
  };

  const handleSendMessage = (e) => {
    e.preventDefault();
    if (!chatInput.trim()) return;
    
    const userMsg = chatInput;
    setChatMessages(prev => [...prev, { sender: 'user', text: userMsg }]);
    setChatInput('');

    setTimeout(() => {
      let botReply = "I'm here to help! You can use coupon 'SUPERDEAL' at checkout for an extra 50% off our already negligible prices!";
      if (userMsg.toLowerCase().includes('flight')) {
        botReply = "Our flights start as low as $9.99! Check out JetPenny Air to Las Vegas.";
      } else if (userMsg.toLowerCase().includes('bus') || userMsg.toLowerCase().includes('train')) {
        botReply = "MegaBudget Bus tickets start at just $0.99 with full AC and WiFi included!";
      } else if (userMsg.toLowerCase().includes('cancel') || userMsg.toLowerCase().includes('refund')) {
        botReply = "All tickets feature instant 100% full digital wallet refunds up to 2 hours before departure!";
      }
      setChatMessages(prev => [...prev, { sender: 'bot', text: botReply }]);
    }, 800);
  };

